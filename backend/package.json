{
  "name": "evergreen-portal-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend for the Evergreen Apartment portal — schema, API, jobs, scripts.",
  "scripts": {
    "import:members": "tsx scripts/import-members.ts",
    "db:reset": "echo 'Run schema/*.sql in order against your Supabase database.'",
    "db:dump": "supabase db dump --schema public > dump-$(date +%Y%m%d).sql",
    "functions:deploy": "supabase functions deploy dispatch-reminders",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "evergreen-portal": "file:..",
    "jszip": "^3.10.1",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
