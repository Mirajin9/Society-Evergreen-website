# ─── Required env vars ───────────────────────────────────────────────────
# Copy this file to .env.local (gitignored) and fill in the values.

# ── Supabase ─────────────────────────────────────────────────────────────
# From your Supabase project dashboard → Project Settings → API.
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=eyJ... (anon public key)
SUPABASE_SERVICE_ROLE_KEY=eyJ... (service role key — KEEP SECRET)

# Mirrored for the browser. Next.js requires the NEXT_PUBLIC_ prefix
# to expose env vars to client-side bundles.
NEXT_PUBLIC_SUPABASE_URL=$SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
NEXT_PUBLIC_BASE_URL=https://evergreen-dwarka.in   # use http://localhost:3000 in dev

# ── Resend (email) ───────────────────────────────────────────────────────
# Sign up at resend.com → API Keys → create a Restricted key.
RESEND_API_KEY=re_...
SENDER_EMAIL=notices@evergreen-dwarka.in   # must be a verified sender domain

# ── Edge Function secrets ────────────────────────────────────────────────
# Random string used to gate the reminder Edge Function from public invocation.
FUNCTION_SECRET=change-me-to-a-long-random-string

# Cron job that calls the Edge Function uses this as the Bearer token:
#   select net.http_post(url := '…/dispatch-reminders',
#       headers := jsonb_build_object('Authorization', 'Bearer ' || current_setting('app.function_secret')));

# ── Portal URL passed to the cron job ────────────────────────────────────
PORTAL_URL=https://evergreen-dwarka.in
